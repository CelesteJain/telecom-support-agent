config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	mask(mask)
	classify(classify)
	retrieve(retrieve)
	diagnose(diagnose)
	approval(approval)
	answer(answer)
	check(check)
	unmask(unmask)
	__end__([<p>__end__</p>]):::last
	__start__ --> mask;
	answer --> check;
	approval --> answer;
	check --> unmask;
	classify -. &nbsp;account&nbsp; .-> diagnose;
	classify -. &nbsp;knowledge&nbsp; .-> retrieve;
	diagnose -.-> answer;
	diagnose -.-> approval;
	mask --> classify;
	retrieve --> answer;
	unmask --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
